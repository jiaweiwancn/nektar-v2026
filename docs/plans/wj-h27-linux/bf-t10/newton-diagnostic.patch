+void WriteDiagnosticLinearChecks(const SteadyKrylovResult &result,
+                                 std::uint64_t step, int attempt)
+{
+    for (const auto &n : result.newton)
+    {
+        double initialScaled = 0.;
+        double bestRatio = std::numeric_limits<double>::infinity();
+        double scaledRatio = 0., physicalRatio = 0.;
+        int cycles = 0, iterations = 0;
+        for (const auto &l : result.linear)
+        {
+            if (l.newton != n.iteration)
+            {
+                continue;
+            }
+            cycles = l.cycle + 1;
+            iterations += l.iteration >= 0;
+            if (l.cycle == 0 && l.iteration == -1)
+            {
+                initialScaled = l.trueScaledNorm;
+            }
+            if (l.trueChecked && initialScaled > 0. && n.baseNorm > 0.)
+            {
+                const double scaled = l.trueScaledNorm / (n.forcing * initialScaled);
+                const double physical = l.trueNorm / (n.forcing * n.baseNorm);
+                const double ratio = std::max(scaled, physical);
+                if (ratio < bestRatio)
+                {
+                    bestRatio = ratio;
+                    scaledRatio = scaled;
+                    physicalRatio = physical;
+                }
+            }
+        }
+        if (std::isfinite(bestRatio))
+        {
+            std::ostringstream line;
+            line << std::setprecision(17) << "WJ_GATE_LINEAR {\"step\":" << step
+                 << ",\"attempt\":" << attempt << ",\"newton\":" << n.iteration
+                 << ",\"base_max\":" << n.baseNorm << ",\"eta\":" << n.forcing
+                 << ",\"cycles\":" << cycles << ",\"iterations\":" << iterations
+                 << ",\"best_scaled_over_target\":" << scaledRatio
+                 << ",\"best_physical_over_target\":" << physicalRatio
+                 << ",\"passed\":" << (n.linearConverged ? "true" : "false") << '}';
+            std::cout << line.str() << std::endl;
+        }
+    }
+}
+void WriteDiagnosticLineSearch(const SteadyKrylovResult &result,
+                               std::uint64_t step, int attempt)
+{
+    for (const auto &n : result.newton)
+    {
+        int inadmissible = 0, insufficientDecrease = 0, feasible = 0;
+        double bestMerit = std::numeric_limits<double>::infinity();
+        std::string firstInadmissibility, lastInadmissibility;
+        for (const auto &trial : result.lineSearch)
+        {
+            if (trial.newton != n.iteration)
+            {
+                continue;
+            }
+            if (!trial.admissible)
+            {
+                ++inadmissible;
+                if (firstInadmissibility.empty())
+                {
+                    firstInadmissibility = trial.reason;
+                }
+                lastInadmissibility = trial.reason;
+            }
+            else if (trial.evaluated)
+            {
+                ++feasible;
+                insufficientDecrease += !trial.sufficientDecrease;
+                bestMerit = std::min(bestMerit, trial.trueNorm);
+            }
+        }
+        if (feasible + inadmissible == 0)
+        {
+            continue;
+        }
+        std::ostringstream line;
+        line << std::setprecision(17) << "WJ_GATE_LINE_SEARCH {\"step\":" << step
+             << ",\"attempt\":" << attempt << ",\"newton\":" << n.iteration
+             << ",\"base_max\":" << n.baseNorm << ",\"accepted_scale\":" << n.acceptedStep
+             << ",\"feasible\":" << feasible << ",\"inadmissible\":" << inadmissible
+             << ",\"insufficient_decrease\":" << insufficientDecrease << ",\"best_feasible_max\":";
+        if (std::isfinite(bestMerit))
+        {
+            line << bestMerit;
+        }
+        else
+        {
+            line << "null";
+        }
+        line << ",\"first_inadmissibility\":" << RANSWallSolveJson::Quote(firstInadmissibility)
+             << ",\"last_inadmissibility\":" << RANSWallSolveJson::Quote(lastInadmissibility) << '}';
+        std::cout << line.str() << std::endl;
+    }
+}
