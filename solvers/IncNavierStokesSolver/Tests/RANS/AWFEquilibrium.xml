<?xml version='1.0' encoding='utf-8'?>
<NEKTAR>
  <EXPANSIONS>
    <E COMPOSITE="C[0]" NUMMODES="5,5" BASISTYPE="Modified_A,Modified_A" POINTSTYPE="GaussLobattoLegendre,GaussLobattoLegendre" NUMPOINTS="10,10" FIELDS="u,v,k,eps_tilde" />
