  </EXPANSIONS>
  <CONDITIONS>
    <SOLVERINFO>
      <I PROPERTY="SolverType" VALUE="RANSVelocityCorrectionScheme" />
      <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
      <I PROPERTY="Projection" VALUE="Galerkin" />
      <I PROPERTY="TurbulenceModel" VALUE="CLSHighRe" />
