      <I PROPERTY="GlobalSysSoln" VALUE="DirectStaticCond" />
      <I PROPERTY="RANSWallModel" VALUE="AWFEquilibrium" />
      <I PROPERTY="RANSAWFWeight" VALUE="Switched" />
      <I PROPERTY="RANSAWFFailurePolicy" VALUE="RequirePreservation" />
    </SOLVERINFO>
    <TIMEINTEGRATIONSCHEME>
