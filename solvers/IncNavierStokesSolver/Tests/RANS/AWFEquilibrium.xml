      <P>RANSNonlinearTolerance = 1e-10</P>
      <P>RANSMaxIterations = 2000</P>
      <P>Ustar = 0.4</P>
      <P>Kappa = 0.440553905186659</P>
      <P>Z0 = 0.02</P>
      <P>Qstar = 3.190675081624288</P>
      <P>MatchingVelocity = 5.780254367996082</P>
      <P>RANSRoughnessHeight = 0.1</P>
      <P>RANSStripHeight = 2</P>
      <P>RANSStripPointP = 1.0</P>
      <P>RANSStripPointN = 4.0</P>
      <P>RANSPicardRelaxation = 0.1</P>
      <P>RANSAWFFixedWeight = 1.0</P>
      <P>RANSAWFOn = 0.02</P>
      <P>RANSAWFOff = 0.1</P>
      <P>RANSStageAudit = 1</P>
      <P>RANSAWFPointDiagnostics = 1</P>
      <P>RANSAWFMinimumRe = 100</P>
      <P>RANSAWFDirectionX = 1.0</P>
      <P>RANSAWFDirectionY = 0.0</P>
    </PARAMETERS>
    <VARIABLES>
      <V ID="0">u</V>
      <V ID="1">v</V>
      <V ID="2">k</V>
      <V ID="3">eps_tilde</V>
      <V ID="4">p</V>
    </VARIABLES>
    <BOUNDARYREGIONS>
      <B ID="0">C[1]</B>
      <B ID="1">C[2]</B>
      <B ID="2">C[3]</B>
      <B ID="3">C[4]</B>
    </BOUNDARYREGIONS>
    <BOUNDARYCONDITIONS>
      <REGION REF="0">
        <R VAR="u" USERDEFINEDTYPE="AWFEquilibrium" VALUE="0" PRIMCOEFF="0" />
        <D VAR="v" VALUE="0" />
        <R VAR="k" USERDEFINEDTYPE="AWFEquilibrium" VALUE="0" PRIMCOEFF="0" />
        <D VAR="eps_tilde" VALUE="Ustar^3/(Kappa*y)" />
        <N VAR="p" USERDEFINEDTYPE="RANSPressure" VALUE="0" />
      </REGION>
      <REGION REF="1">
        <P VAR="u" VALUE="[3]" />
        <P VAR="v" VALUE="[3]" />
        <P VAR="k" VALUE="[3]" />
        <P VAR="eps_tilde" VALUE="[3]" />
        <P VAR="p" VALUE="[3]" />
      </REGION>
      <REGION REF="2">
        <N VAR="u" VALUE="(1)*(Ustar^2)" />
        <D VAR="v" VALUE="0" />
        <N VAR="k" VALUE="0" />
        <N VAR="eps_tilde" VALUE="-Ustar^4/(1.3*30)" />
        <N VAR="p" USERDEFINEDTYPE="RANSPressure" VALUE="0" />
      </REGION>
      <REGION REF="3">
        <P VAR="u" VALUE="[1]" />
        <P VAR="v" VALUE="[1]" />
        <P VAR="k" VALUE="[1]" />
        <P VAR="eps_tilde" VALUE="[1]" />
        <P VAR="p" VALUE="[1]" />
      </REGION>
    </BOUNDARYCONDITIONS>
    <FUNCTION NAME="InitialConditions">
      <E VAR="u" VALUE="MatchingVelocity+Ustar/Kappa*log(y/2)" />
      <E VAR="v" VALUE="0" />
      <E VAR="k" VALUE="Qstar*Ustar^2" />
      <E VAR="eps_tilde" VALUE="Ustar^3/(Kappa*y)" />
      <E VAR="p" VALUE="0" />
    </FUNCTION>
    <FUNCTION NAME="ExactSolution">
      <E VAR="u" VALUE="MatchingVelocity+Ustar/Kappa*log(y/2)" />
      <E VAR="v" VALUE="0" />
      <E VAR="k" VALUE="Qstar*Ustar^2" />
      <E VAR="eps_tilde" VALUE="Ustar^3/(Kappa*y)" />
      <E VAR="p" VALUE="0" />
    </FUNCTION>
  </CONDITIONS>
